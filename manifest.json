{
  "manifest_version": 3,
  "name": "AI Export Assistant",
  "version": "1.1.0",
  "description": "Export ChatGPT, Claude, DeepSeek, Gemini conversations to Word, PDF, Markdown with one click.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AI Export Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://chat.deepseek.com/*",
    "https://gemini.google.com/*",
    "https://tongyi.aliyun.com/*",
    "https://qianwen.aliyun.com/*",
    "https://kimi.moonshot.cn/*",
    "https://doubao.com/*",
    "https://www.doubao.com/*",
    "https://yiyan.baidu.com/*",
    "https://perplexity.ai/*",
    "https://api.gumroad.com/*",
    "https://gumroad.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://chat.deepseek.com/*",
        "https://gemini.google.com/*",
        "https://tongyi.aliyun.com/*",
        "https://qianwen.aliyun.com/*",
        "https://kimi.moonshot.cn/*",
        "https://doubao.com/*",
        "https://www.doubao.com/*",
        "https://yiyan.baidu.com/*",
        "https://perplexity.ai/*"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "options_page": "options/options.html",
  "default_locale": "en",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Open AI Export Assistant"
    },
    "export-markdown": {
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "Command+Shift+M"
      },
      "description": "Quick export as Markdown"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lib/*.js",
        "content/content.js",
        "welcome/welcome.html"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}